from django.conf import settings
from django.core.exceptions import ValidationError
from django.db import models

SUPPORTED_LANGUAGES = {"english": {"en"}, "arabic": {"ar"}, "both": {"en", "ar"}}
PROJECT_LANGUAGE = "[[ language ]]"


def validate_translated_text(value):
    if not isinstance(value, dict) or not value:
        raise ValidationError("Translated content must be a non-empty object")
    if set(value) - SUPPORTED_LANGUAGES[PROJECT_LANGUAGE]:
        raise ValidationError("Content includes a language disabled for this project")
    if not all(isinstance(item, str) and item.strip() for item in value.values()):
        raise ValidationError("Every translation must be non-empty text")


def resolve_translated_text(value, accept_language="en"):
    """Resolve a translated object while preserving the stable object API."""
    if not value:
        return ""
    requested = accept_language.split(",", 1)[0].split("-", 1)[0].lower()
    for language in (requested, "en", "ar"):
        if language in value:
            return value[language]
    return next(iter(value.values()))


class ActiveManager(models.Manager):
    def get_queryset(self):
        return super().get_queryset().filter(deleted_at__isnull=True)


class AuditedModel(models.Model):
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    created_by = models.ForeignKey(settings.AUTH_USER_MODEL, null=True, blank=True, on_delete=models.SET_NULL, related_name="+")
    updated_by = models.ForeignKey(settings.AUTH_USER_MODEL, null=True, blank=True, on_delete=models.SET_NULL, related_name="+")
    deleted_at = models.DateTimeField(null=True, blank=True, db_index=True)
    deleted_by = models.ForeignKey(settings.AUTH_USER_MODEL, null=True, blank=True, on_delete=models.SET_NULL, related_name="+")

    objects = ActiveManager()
    all_objects = models.Manager()

    class Meta:
        abstract = True
